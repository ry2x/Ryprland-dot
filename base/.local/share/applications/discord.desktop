[Desktop Entry]
Name=Vesktop
StartupWMClass=vesktop
Comment=Discord client with Vencord built in.
GenericName=Internet Messenger
Exec=vesktop %U
Icon=vesktop
Terminal=false
# Keep existing Discord launcher references working; use the packaged Vesktop entry in menus.
NoDisplay=true
MimeType=x-scheme-handler/discord;
Type=Application
Categories=Network;InstantMessaging;
Path=/usr/bin
