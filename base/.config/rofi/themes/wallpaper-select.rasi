/***
 *    ┓ ┏┏┓┓ ┓ ┏┓┏┓┓ ┏┓┏┓┏┳┓
 *    ┃┃┃┣┫┃ ┃ ┗┓┣ ┃ ┣ ┃  ┃
 *    ┗┻┛┛┗┗┛┗┛┗┛┗┛┗┛┗┛┗┛ ┻
 *
 */

configuration {
    modi:                        "drun";
    show-icons:                  true;
    hover-select:                true;
    me-select-entry:             "MouseSecondary";
    me-accept-entry:             "MousePrimary";
}

@import "~/.config/rofi/shared/colors.rasi"
@import "~/.config/rofi/shared/fonts.rasi"

/* Centered translucent gallery ------------------------------------ */
window {
    enabled:                     true;
    fullscreen:                  false;
    width:                       44%;
    height:                      47%;
    transparency:                "real";
    cursor:                      "default";
    padding:                     30px;
    border:                      2px solid;
    border-radius:               18px;
    border-color:                white/16%;
    background-color:            @background-alpha;
}

mainbox {
    children:                    [ "headerbar", "inputbar", "listview" ];
    spacing:                     18px;
    padding:                     0px;
    background-color:            transparent;
}

/* Gallery title and dynamic item count ---------------------------- */
headerbar {
    expand:                      false;
    orientation:                 horizontal;
    children:                    [ "textbox-gallery-icon", "textbox-gallery-title", "textbox-gallery-spacer", "textbox-gallery-count" ];
    spacing:                     12px;
    padding:                     0px 8px;
    background-color:            transparent;
    vertical-align:              0.5;
}

textbox-gallery-icon {
    expand:                      false;
    content:                     "󰋩";
    padding:                     0px;
    background-color:            transparent;
    text-color:                  @border-color;
    font:                        "GeistMono Nerd Font Bold 22";
    vertical-align:              0.5;
}

textbox-gallery-title {
    expand:                      false;
    content:                     "Wallpapers";
    background-color:            transparent;
    text-color:                  @foreground;
    font:                        "GeistMono Nerd Font Bold 18";
    vertical-align:              0.5;
}

textbox-gallery-spacer {
    expand:                      true;
    content:                     "";
    background-color:            transparent;
}

textbox-gallery-count {
    expand:                      false;
    content:                     "0 items";
    background-color:            transparent;
    text-color:                  white/48%;
    font:                        "GeistMono Nerd Font Bold 11";
    vertical-align:              0.5;
}

/* Standalone search field ----------------------------------------- */
inputbar {
    expand:                      false;
    orientation:                 horizontal;
    children:                    [ "textbox-prompt-colon", "entry" ];
    spacing:                     10px;
    padding:                     11px 15px;
    border:                      2px solid;
    border-radius:               13px;
    border-color:                white/11%;
    background-color:            white/4%;
}

textbox-prompt-colon {
    expand:                      false;
    str:                         "";
    padding:                     3px 7px 3px 3px;
    background-color:            transparent;
    text-color:                  @foreground;
    font:                        "GeistMono Nerd Font Bold 15";
    vertical-align:              0.5;
}

entry {
    expand:                      true;
    cursor:                      text;
    placeholder:                 "Search wallpapers...";
    placeholder-color:           white/48%;
    padding:                     3px 0px;
    background-color:            transparent;
    text-color:                  @foreground;
    font:                        "GeistMono Nerd Font Bold 11";
}

/* Three-column wallpaper grid ------------------------------------- */
listview {
    expand:                      true;
    columns:                     3;
    lines:                       2;
    spacing:                     16px 18px;
    padding:                     6px 0px 0px;
    cycle:                       true;
    dynamic:                     false;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @foreground;
}

element {
    orientation:                 vertical;
    spacing:                     0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               13px;
    border-color:                white/9%;
    cursor:                      pointer;
    background-color:            white/3%;
    text-color:                  @foreground;
}

element normal.normal,
element alternate.normal {
    background-color:            white/3%;
    border-color:                white/9%;
}

element selected.normal {
    background-color:            @primary-alpha;
    border-color:                @border-color;
}

element-icon {
    size:                        184px;
    width:                       280px;
    height:                      184px;
    squared:                     false;
    expand:                      false;
    border-radius:               11px;
    cursor:                      inherit;
    background-color:            transparent;
}

element-text {
    enabled:                     false;
}

scrollbar {
    margin:                      0px 0px 0px 5px;
    handle-width:                6px;
    handle-color:                @border-color;
    background-color:            white/5%;
    border-radius:               4px;
}

message {
    background-color:            transparent;
}

textbox {
    background-color:            transparent;
    text-color:                  @foreground;
}

error-message {
    padding:                     24px;
    border-radius:               13px;
    background-color:            @background-alt;
    text-color:                  @urgent;
}
